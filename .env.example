# RecMap needs a real Anthropic API key on the server. Copy this file to
# .env.local and fill in your key — .env.local is gitignored and is never sent to the client.

ANTHROPIC_API_KEY=sk-ant-...

# Optional. Signs session cookies (see lib/auth.ts). If left unset, a random
# secret is generated on first run and saved to data/.session_secret (also
# gitignored) — fine for local use, but set a real fixed value yourself for
# any real deployment so sessions survive a redeploy.
SESSION_SECRET=

# Optional persistent storage root. Render sets this to its mounted disk.
# RECMAP_DATA_DIR=

# Keep uploads disabled unless the deployment has a persistent disk and you
# intend to accept uploaded guidelines.
# NEXT_PUBLIC_UPLOAD_FEATURE_ENABLED=false

# Demo-only access. Anyone who can open the app can enter without an account.
# Keep false for real deployments.
# NEXT_PUBLIC_DEMO_MODE=false
